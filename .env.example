# =============================================================================
# Planilha Certa — Configuração de Ambiente (.env.example)
# =============================================================================
# Instruções:
# 1. Copie este arquivo para um novo arquivo chamado ".env" na raiz do projeto.
# 2. Substitua os valores de exemplo abaixo pelas configurações reais, caso
#    utilize recursos externos (como o desafio de persistência no Google Drive).
# 3. Nunca envie o arquivo ".env" com credenciais reais para o repositório Git.
# =============================================================================

# Diretório padrão para armazenamento de dados locais (CSV, JSON ou TXT)
DATA_DIR=./data

# Formato de persistência escolhido pelo grupo (CSV, JSON ou TXT)
DATA_FORMAT=JSON

# Diretório para exportação de relatórios gerados (ex.: PDF via iText)
REPORTS_OUTPUT_DIR=./data/reports

# -----------------------------------------------------------------------------
# Desafio Opcional: Integração com Google Drive
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_ENABLED=false
GOOGLE_APPLICATION_NAME=PlanilhaCertaConsultoria
GOOGLE_CREDENTIALS_FILE_PATH=./credentials.json
GOOGLE_DRIVE_FOLDER_ID=sua_pasta_id_falsa_aqui_123456
